<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    style="@style/PTScreen">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/pt_space_l"
        android:paddingTop="@dimen/pt_space_l"
        android:paddingEnd="@dimen/pt_space_l"
        android:paddingBottom="@dimen/pt_space_xl">

        <TextView
            android:id="@+id/flow_step"
            style="@style/PTSectionHeader"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="0dp"
            android:paddingEnd="0dp"
            android:paddingTop="0dp"
            android:text="@string/flow_step_pairing" />

        <TextView
            android:id="@+id/flow_mode"
            style="@style/PTRowDesc"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <TextView
            style="@style/PTPageTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/pt_space_s"
            android:text="@string/flow_pairing_title" />

        <TextView
            android:id="@+id/pairing_hint"
            style="@style/PTBody"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/pt_space_s" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/pt_space_l"
            android:background="@drawable/bg_card"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="@dimen/pt_space_l">

            <TextView
                style="@style/PTRowDesc"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/flow_pairing_code_label" />

            <TextView
                android:id="@+id/pairing_code"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/pt_space_s"
                android:letterSpacing="0.12"
                android:textColor="@color/pt_primary"
                android:textSize="40sp"
                android:textStyle="bold" />

            <TextView
                style="@style/PTRowDesc"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/pt_space_s"
                android:text="@string/flow_pairing_ttl" />
        </LinearLayout>

        <TextView
            style="@style/PTRowDesc"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/pt_space_m"
            android:text="@string/flow_pairing_note" />

        <EditText
            android:id="@+id/pairing_code_input"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/pt_space_m"
            android:hint="@string/pairing_code_input_hint"
            android:importantForAutofill="no"
            android:inputType="number"
            android:maxLength="6"
            android:visibility="gone" />

        <TextView
            android:id="@+id/pairing_status"
            style="@style/PTBody"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/pt_space_m"
            android:text="@string/flow_p2p_idle" />

        <LinearLayout
            android:id="@+id/pairing_peers"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/pt_space_s"
            android:orientation="vertical" />

        <TextView
            android:id="@+id/pairing_regenerate"
            style="@style/PTRowTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/pt_space_m"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            android:padding="@dimen/pt_space_s"
            android:text="@string/flow_pairing_regenerate" />

        <Button
            android:id="@+id/pairing_start"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/pt_space_l"
            android:text="@string/flow_pairing_start" />
    </LinearLayout>
</ScrollView>
