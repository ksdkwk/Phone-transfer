<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    style="@style/PTScreen">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/pt_space_l"
        android:paddingTop="@dimen/pt_space_l"
        android:paddingEnd="@dimen/pt_space_l"
        android:paddingBottom="@dimen/pt_space_xl">

        <TextView
            android:id="@+id/flow_step"
            style="@style/PTSectionHeader"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="0dp"
            android:paddingEnd="0dp"
            android:paddingTop="0dp"
            android:text="@string/flow_step_role" />

        <TextView
            android:id="@+id/flow_mode"
            style="@style/PTRowDesc"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <TextView
            style="@style/PTPageTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/pt_space_s"
            android:text="@string/flow_role_title" />

        <TextView
            style="@style/PTBody"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/pt_space_s"
            android:text="@string/flow_role_hint" />

        <LinearLayout
            android:id="@+id/role_old"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/pt_space_xl"
            android:background="@drawable/bg_card"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackground"
            android:orientation="vertical"
            android:padding="@dimen/pt_space_l">

            <TextView
                style="@style/PTRowTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/flow_role_old" />

            <TextView
                style="@style/PTRowDesc"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/flow_role_old_desc" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/role_new"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/pt_space_m"
            android:background="@drawable/bg_card"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackground"
            android:orientation="vertical"
            android:padding="@dimen/pt_space_l">

            <TextView
                style="@style/PTRowTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/flow_role_new" />

            <TextView
                style="@style/PTRowDesc"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/flow_role_new_desc" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
