<?xml version="1.0" encoding="utf-8"?>
<!-- 通用文本页：迁移报告空态 / 权限与隐私 / 关于 -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    style="@style/PTScreen">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/pt_space_l"
        android:paddingTop="@dimen/pt_space_l"
        android:paddingEnd="@dimen/pt_space_l"
        android:paddingBottom="@dimen/pt_space_xl">

        <TextView
            android:id="@+id/page_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            style="@style/PTPageTitle" />

        <TextView
            android:id="@+id/page_body"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/pt_space_m"
            style="@style/PTBody" />
    </LinearLayout>

</ScrollView>
