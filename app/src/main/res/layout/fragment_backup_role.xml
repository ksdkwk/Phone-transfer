<?xml version="1.0" encoding="utf-8"?>
<!--
  文件备份（SoftAP + TCP）· 第 1 步：选择本机角色。
  旧机 = 热点 + 协议发送端；新机 = 接入热点 + 协议接收端。
-->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    style="@style/PTScreen">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/pt_space_l"
        android:paddingTop="@dimen/pt_space_l"
        android:paddingEnd="@dimen/pt_space_l"
        android:paddingBottom="@dimen/pt_space_xl">

        <TextView
            style="@style/PTSectionHeader"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="0dp"
            android:paddingEnd="0dp"
            android:paddingTop="0dp"
            android:text="@string/backup_title" />

        <TextView
            style="@style/PTPageTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/pt_space_s"
            android:text="@string/backup_role_title" />

        <TextView
            style="@style/PTBody"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/pt_space_s"
            android:text="@string/backup_role_hint" />

        <LinearLayout
            android:id="@+id/backup_role_old"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/pt_space_l"
            android:background="@drawable/bg_card"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackground"
            android:orientation="vertical"
            android:padding="@dimen/pt_space_l">

            <TextView
                style="@style/PTRowTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/backup_role_old" />

            <TextView
                style="@style/PTBody"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/pt_space_s"
                android:text="@string/backup_role_old_desc" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/backup_role_new"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/pt_space_m"
            android:background="@drawable/bg_card"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackground"
            android:orientation="vertical"
            android:padding="@dimen/pt_space_l">

            <TextView
                style="@style/PTRowTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/backup_role_new" />

            <TextView
                style="@style/PTBody"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/pt_space_s"
                android:text="@string/backup_role_new_desc" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
