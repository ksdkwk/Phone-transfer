<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    style="@style/PTScreen">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/pt_space_l"
        android:paddingTop="@dimen/pt_space_l"
        android:paddingEnd="@dimen/pt_space_l"
        android:paddingBottom="@dimen/pt_space_xl">

        <TextView
            style="@style/PTPageTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/flow_report_title" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/pt_space_m"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:padding="@dimen/pt_space_l">

            <TextView
                android:id="@+id/report_summary"
                style="@style/PTBody"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <TextView
                android:id="@+id/report_verify"
                style="@style/PTBody"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/pt_space_s" />
        </LinearLayout>

        <TextView
            style="@style/PTSectionHeader"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/flow_report_items_title" />

        <LinearLayout
            android:id="@+id/report_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:paddingStart="@dimen/pt_space_l"
            android:paddingEnd="@dimen/pt_space_l" />

        <TextView
            android:id="@+id/report_cleanup"
            style="@style/PTBody"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/pt_space_m"
            android:text="@string/flow_report_cleanup" />

        <TextView
            style="@style/PTRowDesc"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/pt_space_s"
            android:text="@string/flow_report_demo_note" />

        <Button
            android:id="@+id/report_done"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/pt_space_l"
            android:text="@string/flow_report_done" />
    </LinearLayout>
</ScrollView>
