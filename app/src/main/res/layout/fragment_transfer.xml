<?xml version="1.0" encoding="utf-8"?>
<!--
  「换机」功能区：上方大片区域一分为二
    · 左半部分：同品牌换机
    · 右半部分：跨 Android 品牌换机
  下方整行卡片：文件备份（SoftAP + TCP，不依赖 P2P 硬件）。
  底部一行小字说明换机主流程中 Wi-Fi Direct 之外的通道尚未接入。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    style="@style/PTScreen"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal"
        android:padding="@dimen/pt_space_l">

        <LinearLayout
            android:id="@+id/transfer_half_same_brand"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginEnd="@dimen/pt_space_s"
            android:background="@drawable/bg_card"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackground"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="@dimen/pt_space_l">

            <ImageView
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_tab_transfer" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/pt_space_m"
                android:gravity="center"
                android:text="@string/transfer_same_brand"
                android:textColor="@color/pt_text_primary"
                android:textSize="@dimen/pt_text_row_title"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/pt_space_s"
                android:gravity="center"
                android:text="@string/transfer_same_brand_desc"
                style="@style/PTBody" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/transfer_half_cross_brand"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginStart="@dimen/pt_space_s"
            android:background="@drawable/bg_card"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackground"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="@dimen/pt_space_l">

            <ImageView
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_tab_transfer" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/pt_space_m"
                android:gravity="center"
                android:text="@string/transfer_cross_brand"
                android:textColor="@color/pt_text_primary"
                android:textSize="@dimen/pt_text_row_title"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/pt_space_s"
                android:gravity="center"
                android:text="@string/transfer_cross_brand_desc"
                style="@style/PTBody" />
        </LinearLayout>

    </LinearLayout>

    <LinearLayout
        android:id="@+id/transfer_backup"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/pt_space_l"
        android:layout_marginEnd="@dimen/pt_space_l"
        android:layout_marginTop="@dimen/pt_space_m"
        android:background="@drawable/bg_card"
        android:clickable="true"
        android:focusable="true"
        android:foreground="?attr/selectableItemBackground"
        android:orientation="vertical"
        android:padding="@dimen/pt_space_l">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/backup_entry_title"
            android:textColor="@color/pt_text_primary"
            android:textSize="@dimen/pt_text_row_title"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/pt_space_s"
            android:gravity="center"
            android:text="@string/backup_entry_desc"
            style="@style/PTBody" />
    </LinearLayout>
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:paddingStart="@dimen/pt_space_l"
        android:paddingEnd="@dimen/pt_space_l"
        android:paddingBottom="@dimen/pt_space_m"
        android:text="@string/transfer_stage_banner"
        android:textColor="@color/pt_text_disabled"
        android:textSize="@dimen/pt_text_desc" />

</LinearLayout>